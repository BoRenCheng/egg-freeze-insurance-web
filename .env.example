# =====================================================
# 環境變數範本 — 複製為 .env 後填入實際值
#   cp .env.example .env
# .env 檔案絕對不可提交到 Git！
# =====================================================

# JWT 簽章金鑰（建議使用以下指令生成）
#   PowerShell: [Convert]::ToBase64String((1..48 | %{Get-Random -Min 0 -Max 256}))
#   Bash:       openssl rand -base64 48
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars

# Gemini API Key — 從 https://aistudio.google.com/apikey 取得
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# 伺服器設定
PORT=5000
NODE_ENV=production
DB_PATH=/data/insurance.db
